{
  "uid": "easydora-business",
  "title": "EasyDora / Business metrics",
  "description": "The five deliberately-chosen business counters -- see ADR-0036 for why these and not more.",
  "tags": ["easydora"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Orders created/s",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(orders_created_total[5m])",
          "legendFormat": "orders created",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Payments approved vs failed /s",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(payments_approved_total[5m])",
          "legendFormat": "approved",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(payments_failed_total[5m])",
          "legendFormat": "failed",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Payment failure rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(payments_failed_total[15m]) / (rate(payments_approved_total[15m]) + rate(payments_failed_total[15m]))",
          "legendFormat": "failure rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Stock reservations failed/s",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(inventory_reservations_failed_total[5m])",
          "legendFormat": "reservations failed",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Notifications sent/s",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(notifications_sent_total[5m])",
          "legendFormat": "notifications sent",
          "refId": "A"
        }
      ]
    }
  ]
}
