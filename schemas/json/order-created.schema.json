{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easydora.internal/schemas/order-created.schema.json",
  "title": "order.created",
  "description": "Published by orders-service (RabbitMQ order.exchange, routing key order.created) after an order is created. Consumed by billing-service and notification-service.",
  "type": "object",
  "properties": {
    "orderId": { "type": "string" },
    "userId": { "type": "integer" },
    "totalAmount": { "type": "number" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "productId": { "type": "string" },
          "quantity": { "type": "integer" },
          "unitPrice": { "type": "number" }
        },
        "required": ["productId", "quantity", "unitPrice"]
      }
    },
    "createdAt": { "type": "string" }
  },
  "required": ["orderId", "userId", "totalAmount", "items", "createdAt"]
}
