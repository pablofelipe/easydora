# Copy to .env and fill in real values. .env is gitignored — never commit it.
DB_PASSWORD=changeme
RABBITMQ_PASSWORD=changeme
JWT_SECRET=changeme
APP_JWT_SECRET=changeme

# Bootstraps auth-service's one platform-operations (ADMIN) account on
# first boot if it doesn't already exist (see AdminAccountInitializer and
# ADR-0029). Leave both blank to skip the bootstrap entirely -- no
# credential is ever committed to a migration or any other versioned file.
ADMIN_EMAIL=changeme
ADMIN_PASSWORD=changeme

# Grafana's admin account (see ADR-0036). Only used for the dashboards
# provisioned in observability/grafana; not consumed by any service.
GRAFANA_ADMIN_PASSWORD=changeme
